# ============================================================
# Example Environment Configuration for QR Code Hub
# ============================================================

# Backend Port (5001 avoids Windows Hyper-V reserved port 5000)
PORT=5001
DEBUG=false

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qr_codes_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qr_codes_db

# Frontend Vite Port (for local development outside Docker)
VITE_BACKEND_URL=http://localhost:5001
